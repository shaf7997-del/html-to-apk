# متغیرهای محیطی سرور HTML to APK Builder
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید

# پورت سرور
PORT=3001

# مسیر Android SDK
ANDROID_HOME=/opt/android-sdk

# مسیر Java
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# محیط اجرا
NODE_ENV=production

# حداکثر حجم فایل (بایت)
MAX_FILE_SIZE=10485760

# زمان انتظار بیلد (میلی‌ثانیه)
BUILD_TIMEOUT=300000

# مسیر پوشه موقت
TEMP_DIR=./temp

# کلید امضای APK (اختیاری - برای نسخه release)
# KEYSTORE_PATH=./release-key.jks
# KEYSTORE_PASSWORD=your-password
# KEY_ALIAS=your-alias
# KEY_PASSWORD=your-key-password
